# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# 运行时数据（平台数据库 / 任务日志 / 配置备份）
data/
!data/.gitkeep

# 环境变量
.env

# 测试与工具
.pytest_cache/
.ruff_cache/

# AIOS / 工具运行时产物（不入库）
.aios/
.contextdb-enable
.zcode/

# 编辑器
.DS_Store
.idea/
.vscode/

# README 截图原图（只入库 docs/assets 的 webp）
shots/

# 运行时启动产物（nohup 默认输出 / 后台进程垃圾文件）
nohup.out

# lock 文件不入库（避免依赖环境差异污染版本）
uv.lock

# 运行期杂项（不入库，避免 git status 一直飘着）
$null
.rex-harness/
docs/test-design/
