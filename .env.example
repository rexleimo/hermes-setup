# ============================================================
# Hermes Console 运维中台 — 环境变量示例
# 复制为 .env 后按需修改；所有项均有安全默认值
# ============================================================

# 平台监听（默认监听所有接口，含本机回环，开箱即用；只想本机访问可改回 127.0.0.1）
HERMES_CONSOLE_HOST=0.0.0.0
HERMES_CONSOLE_PORT=8420

# 会话密钥（首次部署务必设置；用于签名 Session Cookie 与 CSRF Token）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
HERMES_CONSOLE_SECRET=

# 会话策略（分钟）
HERMES_CONSOLE_SESSION_TTL=720        # 绝对过期
HERMES_CONSOLE_IDLE_TTL=60            # 空闲过期

# Cookie 安全：通过 HTTPS 反代访问时建议开启
HERMES_CONSOLE_SECURE_COOKIES=0

# 管理 IP 白名单（逗号分隔 CIDR；留空 = 不限制）
# 示例：10.0.0.0/8,192.168.1.0/24
HERMES_CONSOLE_ALLOWED_IPS=

# 管理员必须启用 TOTP 两步验证（1 = 强制）
HERMES_CONSOLE_REQUIRE_2FA=0

# Hermes 安装与配置目录（默认 ~ 下自动探测）
# HERMES_HOME=/root/.hermes
# HERMES_BIN=/usr/local/bin/hermes
